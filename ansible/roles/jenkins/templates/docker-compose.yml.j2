services:
  jenkins:
    build:
      context: .
      dockerfile: Dockerfile
    image: {{ jenkins_image }}
    container_name: jenkins
    restart: unless-stopped
    ports:
      - "8080:8080"
    environment:
      TZ: Asia/Seoul
      JAVA_OPTS: "-Duser.timezone=Asia/Seoul"
    group_add:
      - "{{ docker_gid }}"
    volumes:
      - {{ jenkins_home_dir }}:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:8080/login > /dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 90s